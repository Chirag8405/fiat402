# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: E.164 phone number to SMS the Payment Link to on creation, for
# demo convenience. Leave blank to disable.
DEMO_NOTIFY_PHONE=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Postgres ---
DATABASE_URL=

# --- AI Advisory ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Merchant ---
# PORT is not listed here -- on Render it's auto-injected into the merchant's
# `next start` process; no action needed. Only set it yourself for local runs
# that need a non-default port.
MERCHANT_VPA=merchant@ybl
MERCHANT_NAME=fiat402 Demo Merchant
RESOURCE_PRICE_PAISE=10000
# Base URL of the deployed facilitator (no trailing slash), e.g.
# https://fiat402.onrender.com -- the merchant's x402 middleware calls
# FACILITATOR_URL/verify and FACILITATOR_URL/settle over HTTP.
FACILITATOR_URL=

# --- Policy ---
MAX_AMOUNT_PAISE=
ALLOWED_MERCHANTS=
MAX_REQUESTS_PER_MINUTE=
# Shared secret for POST /internal/confirm-gate/:requestId. Optional for demo
# (the route serves unauthenticated with a startup warning if unset), but
# required in production — this route unblocks held/flagged settlements.
CONFIRM_GATE_SECRET=

# --- x402 UPI Client (demo) ---
MERCHANT_URL=
DEMO_PAYER_VPA=

# --- Facilitator server ---
PORT=
# Comma-separated list of allowed CORS origins. Defaults to "*" outside
# production; in production, unset means no cross-origin requests allowed.
ALLOWED_ORIGINS=
