# Resource pricing / identity for the /api/premium-data x402 challenge
# (apps/merchant/lib/x402-middleware.ts's PaymentRequirements.payTo/extra.merchantName/amount).
MERCHANT_VPA=merchant@ybl
MERCHANT_NAME=fiat402 Demo Merchant
RESOURCE_PRICE_PAISE=10000

# Self-facilitation (in-process import of ../../facilitator/src/server.ts): this
# app shares the facilitator's Redis/Postgres/Razorpay/policy env, since
# verifyPayment/settlePayment run in this same process, not over HTTP. See
# apps/facilitator/src/store/{redis,db}.ts, razorpay/client.ts,
# policy/{deterministic,ai-advisory}.ts for what reads each of these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAX_AMOUNT_PAISE=
ALLOWED_MERCHANTS=
MAX_REQUESTS_PER_MINUTE=
GEMINI_API_KEY=
GROQ_API_KEY=
