# In-process import of ../../facilitator/src/{ws,server,store/redis}.ts from
# app/api/stream/route.ts: the dashboard's SSE relay subscribes to the
# facilitator's own Redis pub/sub channel via its adaptUpstashClient, so it
# needs the same Redis credentials rather than standing up a second client
# configuration. Only UPSTASH_* is actually used by this app (the relay only
# ever calls redis.subscribe); the rest are read at import time by other
# top-level exports in apps/facilitator/src/server.ts (razorpayClient,
# pgPool) but construction is lazy/non-throwing on missing values (see those
# files' own comments) -- listed here only so `next dev`/`next build` don't
# warn about undefined env reads.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
